# =============================================================================
# Service de détection — configuration (copier en .env)
# Les valeurs ci-dessous sont les valeurs par défaut, sauf indication contraire.
# Ce fichier sert au lancement local (sans Docker). Dans la pile, le service est lancé par le
# seul docker-compose du dépôt Sentinel-X-G4/main, qui fixe ces variables.
# =============================================================================

# --- MQTT ---------------------------------------------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# Certificat de l'autorité (si TLS) ; MQTT_TLS_INSECURE=true désactive la vérification (dev uniquement)
MQTT_TLS_CA_CERTS=
MQTT_TLS_INSECURE=false
MQTT_CLIENT_ID=detection-service
# Motifs de topics : {device_id} est extrait du topic reçu
MQTT_SENSOR_TOPIC=sentinelx/{device_id}/telemetry
MQTT_CAMERA_TOPIC=sentinelx/{device_id}/camera
MQTT_QOS=0
# Résultats publiés sur ce topic (contrat : docs/BACKEND_CONTRACT.md).
# Vide = envoi HTTP à BACKEND_URL à la place.
MQTT_RESULT_TOPIC=sentinelx/{device_id}/detection
MQTT_RESULT_QOS=1
# Commandes vers les ESP (POST /devices/{id}/...) et leurs acquittements
MQTT_COMMAND_TOPIC=sentinelx/{device_id}/cmd
MQTT_ACK_TOPIC=sentinelx/{device_id}/ack
COMMAND_ACK_TIMEOUT_S=5

# --- Fenêtres et features -----------------------------------------------------
# Période d'inférence (s), déclenchée par une horloge, pas par les messages
INFERENCE_INTERVAL_S=0.5
# Fenêtre courte (PIR, caméra, gaz) et longue (température, humidité), en secondes
SHORT_WINDOW_S=2
LONG_WINDOW_S=60
# Sous ce nombre de mesures dans la fenêtre courte : statut no_data, pas de prédiction
MIN_SAMPLES_SHORT=5
# Sans message capteur depuis ce délai : statut stale
STALE_AFTER_S=10
# Âge maximal d'une lecture DHT22 encore utilisée (sinon temp_last/hum_last = manquant)
DHT_MAX_AGE_S=30
# Une détection caméra reste valable ce temps si la caméra n'a rien publié depuis
# (à augmenter si la caméra ne publie qu'aux changements)
CAMERA_HOLD_S=5

# --- Préchauffage et baseline gaz --------------------------------------------
# Pas de prédiction pendant ce délai après la 1re mesure d'un appareil (ou tant que warmup=true)
WARMUP_SECONDS=120
# Constante de temps de la baseline MQ-2 (s) ; elle est gelée pendant une alerte gaz/feu
BASELINE_TAU_S=600
# Nombre de ticks dont la médiane initialise la baseline après le préchauffage
BASELINE_INIT_TICKS=10

# --- Modèle -------------------------------------------------------------------
# auto = modèles Orange (.pkcls) de MODELS_DIR s'il y en a, sinon règles ;
# orange = modèles obligatoires (arrêt si absents) ; rules = jamais de modèle
PREDICTOR=auto
# Dossier des .pkcls exportés par Orange (widget Save Model). Docker : detection-service/models
# monté sur /models. En local : MODELS_DIR=models
MODELS_DIR=/models
# multilabel : un modèle binaire par alerte, MODELS_DIR/feu.pkcls, fuite_gaz.pkcls, presence.pkcls
#              (les types sans fichier valent 0)
# multiclass : un seul modèle aucune/presence/fuite_gaz/feu, MODELS_DIR/model.pkcls
MODEL_MODE=multilabel
# Chemins explicites, prioritaires sur MODELS_DIR (rarement utile)
MODEL_PATH=
# MODEL_PATHS={"presence": "/models/presence.pkcls", "fuite_gaz": "/models/fuite_gaz.pkcls", "feu": "/models/feu.pkcls"}
MODEL_PATHS=
# Libellé envoyé au backend (model_version) ; vide = rules-v1, ou orange-<empreinte des fichiers>
MODEL_VERSION=
# Nom de la classe « rien à signaler » dans les modèles
MODEL_NEGATIVE_CLASS=aucune
# Seuils du predictor à règles
RULES_GAS_DELTA=150
RULES_TEMP_SLOPE_C_PER_MIN=0.5

# --- Post-traitement ----------------------------------------------------------
# Lissage exponentiel des probabilités (1 = pas de lissage)
SMOOTHING_ALPHA=0.5
# Hystérésis : ON après K prédictions ≥ THRESHOLD_ON, OFF après M prédictions < THRESHOLD_OFF
ALERT_THRESHOLD_ON=0.6
ALERT_THRESHOLD_OFF=0.4
ALERT_K_ON=3
ALERT_M_OFF=6
# Réglages par type, ex. {"feu": {"k_on": 2, "threshold_on": 0.5}}
ALERT_OVERRIDES=
# Filet de sécurité : fuite_gaz forcée si gas_max ≥ ce seuil (ADC 0–1023)…
SAFETY_GAS_CRITICAL=800
# … ou si gas_do_ratio = 1 pendant ce nombre de ticks consécutifs
SAFETY_GAS_DO_TICKS=4

# --- Backend HTTP (seulement si MQTT_RESULT_TOPIC est vide) -------------------
# Vide = rien n'est envoyé (résultats journalisés en DEBUG)
BACKEND_URL=
BACKEND_ALERT_ROUTE=/api/alerts
BACKEND_TOKEN=
BACKEND_TIMEOUT_S=5
BACKEND_MAX_RETRIES=5
BACKEND_BACKOFF_BASE_S=0.5
BACKEND_BACKOFF_MAX_S=10
BACKEND_QUEUE_SIZE=500
HEARTBEAT_INTERVAL_S=10

# --- Base de données ----------------------------------------------------------
# Vide = pas de persistance. Sinon : postgresql+asyncpg://user:pass@hote:5432/base
# La base et son schéma sont dans le dépôt database (db/init/) : le service ne crée aucune table.
DATABASE_URL=
# Schéma PostgreSQL du service (créé par database/db/init/02_detection.sql)
DB_SCHEMA=detection
DB_BATCH_SIZE=200
DB_FLUSH_INTERVAL_S=1
# Mémoire tampon maximale si la base est en panne (au-delà, les mesures brutes les plus anciennes sont jetées)
DB_MAX_BUFFERED_ROWS=50000
# false = n'enregistre les fenêtres de features que pendant une session d'enregistrement
STORE_ALL_FEATURE_WINDOWS=true

# --- API ----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Protège les routes d'action (Bearer) : POST /admin/reload-model et les commandes ESP
# POST /devices/{id}/... ; vide = pas de protection. Pile complète : DETECTION_ADMIN_TOKEN de main/.env
ADMIN_TOKEN=

# --- Logs ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
